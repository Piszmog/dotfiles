{
  "_note": "Allow-by-default. Appended after the built-in defaults in extensions/shell-gate.ts; last match wins, so the catch-all allow comes first, asks carve out of it, the rm carve-outs carve back out of the rm ask, and denies win last. Reload with /reload.",
  "rules": [
    { "pattern": "*", "effect": "allow" },

    { "pattern": "rm *", "effect": "allow" },
    { "pattern": "rm -*", "effect": "ask" },
    { "pattern": "rmdir *", "effect": "ask" },

    { "pattern": "rm /tmp/*", "effect": "allow" },
    { "pattern": "rm -f /tmp/*", "effect": "allow" },
    { "pattern": "rm -rf /tmp/*", "effect": "allow" },
    { "pattern": "rm -fr /tmp/*", "effect": "allow" },
    { "pattern": "rm -rf *node_modules", "effect": "allow" },
    { "pattern": "rm -rf *target", "effect": "allow" },
    { "pattern": "rm -rf *dist", "effect": "allow" },
    { "pattern": "rm -rf *build", "effect": "allow" },
    { "pattern": "rm -rf *coverage", "effect": "allow" },
    { "pattern": "rm -rf *.next", "effect": "allow" },
    { "pattern": "rm -rf *.turbo", "effect": "allow" },

    { "pattern": "git push *", "effect": "ask" },
    { "pattern": "git clean *", "effect": "ask" },
    { "pattern": "git reset --hard*", "effect": "ask" },
    { "pattern": "wget *", "effect": "ask" },
    { "pattern": "gh pr merge *", "effect": "ask" },
    { "pattern": "gh release *", "effect": "ask" },
    { "pattern": "nix store gc*", "effect": "ask" },
    { "pattern": "nix-collect-garbage *", "effect": "ask" },
    { "pattern": "nixos-rebuild switch *", "effect": "ask" },
    { "pattern": "home-manager switch *", "effect": "ask" },

    { "pattern": "*--no-verify*", "effect": "deny" },
    { "pattern": "git add -A*", "effect": "deny" },
    { "pattern": "git add --all*", "effect": "deny" },
    { "pattern": "git add .", "effect": "deny" },
    { "pattern": "git push --force*", "effect": "deny" },
    { "pattern": "git push -f*", "effect": "deny" },
    { "pattern": "git push * main", "effect": "deny" },
    { "pattern": "git push * master", "effect": "deny" },
    { "pattern": "sudo *", "effect": "deny" },
    { "pattern": "doas *", "effect": "deny" },
    { "pattern": "su *", "effect": "deny" },
    { "pattern": "dd *", "effect": "deny" },
    { "pattern": "mkfs*", "effect": "deny" },
    { "pattern": "shutdown *", "effect": "deny" },
    { "pattern": "reboot*", "effect": "deny" },
    { "pattern": "poweroff*", "effect": "deny" },
    { "pattern": "halt*", "effect": "deny" },
    { "pattern": "rm -rf /", "effect": "deny" },
    { "pattern": "rm -rf /bin*", "effect": "deny" },
    { "pattern": "rm -rf /etc*", "effect": "deny" },
    { "pattern": "rm -rf /usr*", "effect": "deny" },
    { "pattern": "rm -rf /var*", "effect": "deny" },
    { "pattern": "rm -rf /System*", "effect": "deny" },
    { "pattern": "rm -rf /Library*", "effect": "deny" },
    { "pattern": "rm -rf /Applications*", "effect": "deny" },
    { "pattern": "rm -rf ~", "effect": "deny" },
    { "pattern": "rm -rf ~/", "effect": "deny" },
    { "pattern": "rm -rf $HOME*", "effect": "deny" },
    { "pattern": "rm -fr /", "effect": "deny" },
    { "pattern": "rm -fr ~", "effect": "deny" },
    { "pattern": "rm -rf \"/\"", "effect": "deny" },
    { "pattern": "rm -rf '/'", "effect": "deny" },
    { "pattern": "rm -rf \"$HOME\"*", "effect": "deny" },
    { "pattern": "rm -rf \"~\"*", "effect": "deny" }
  ]
}

{
  "mcpServers": {
    "cclsp": {
      "command": "npx",
      "args": [
        "-y",
        "cclsp@0.7.0"
      ],
      "env": {
        "CCLSP_CONFIG_PATH": "${HOME}/.config/pi/cclsp.json"
      },
      "description": "LSP navigation for Go, Rust, Python, TypeScript, templ, SQL, HTML, Tailwind, and Nix: definitions, references, hover, workspace symbols, implementations, call hierarchy, rename, and diagnostics.",
      "exposure": "deferred",
      "toolExposure": {
        "find_definition": "direct",
        "find_references": "direct",
        "get_diagnostics": "direct",
        "restart_server": "hidden",
        "*": "deferred"
      },
      "timeout": 120
    },
    "browse": {
      "command": "~/.local/bin/browse",
      "args": [
        "mcp"
      ]
    }
  }
}

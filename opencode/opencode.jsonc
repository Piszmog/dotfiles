{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "opencode-go/deepseek-v4.1-flash",
  "share": "disabled",

  // Policies are binary and cannot be approved away; permissions carry ask/allow ergonomics.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode-go", "effect": "allow" },
    { "action": "provider.use", "resource": "claude-agent", "effect": "allow" },

    { "action": "tool.use", "resource": "shell:git push --force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * main", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * master", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*--no-verify*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit -n*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit -an*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add -A*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add --all*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add .", "effect": "deny" },

    { "action": "tool.use", "resource": "shell:rm -rf /", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf ~", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf ~/", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf $HOME", "effect": "deny" },

    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.envrc", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.envrc.*", "effect": "deny" },

    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env.sample", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env.sample", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env.template", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env.template", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env.dist", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env.dist", "effect": "allow" },

    { "action": "tool.use", "resource": "read:*secrets/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*secrets.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*secrets/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.secrets/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.secrets.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.secrets/*", "effect": "deny" },

    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.gnupg/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.gnupg/*", "effect": "deny" }
  ],

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git rebase origin/*", "effect": "allow" },
    { "action": "shell", "resource": "git rebase --continue", "effect": "allow" },
    { "action": "shell", "resource": "git rebase --abort", "effect": "allow" },
    { "action": "shell", "resource": "git rebase --skip", "effect": "allow" },

    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "go build *", "effect": "allow" },
    { "action": "shell", "resource": "go doc *", "effect": "allow" },
    { "action": "shell", "resource": "gopls *", "effect": "allow" },
    { "action": "shell", "resource": "templ generate *", "effect": "allow" },

    { "action": "shell", "resource": "cargo build *", "effect": "allow" },
    { "action": "shell", "resource": "cargo check *", "effect": "allow" },
    { "action": "shell", "resource": "cargo test *", "effect": "allow" },
    { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
    { "action": "shell", "resource": "cargo fmt *", "effect": "allow" },
    { "action": "shell", "resource": "cargo run *", "effect": "allow" },
    { "action": "shell", "resource": "cargo doc *", "effect": "allow" },
    { "action": "shell", "resource": "cargo nextest *", "effect": "allow" },

    { "action": "shell", "resource": "just *", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },

    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -d *", "effect": "ask" },
    { "action": "shell", "resource": "git branch --delete *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -m *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "execute", "resource": "*", "effect": "allow" }
  ],

  "agents": {
    "build": { "model": "opencode-go/deepseek-v4.1-flash" },
    "opus": {
      "mode": "primary",
      "description": "Opus 5.5 on the Claude subscription: hardest tasks, design, tricky debugging. Uses Claude Code limits.",
      "model": "claude-agent/claude-opus-5-5"
    },
    "sonnet": {
      "mode": "primary",
      "description": "Sonnet 5.5 on the Claude subscription: everyday coding when DeepSeek isn't enough. Uses Claude Code limits.",
      "model": "claude-agent/claude-sonnet-5-5"
    },
    "haiku": {
      "mode": "primary",
      "description": "Haiku 5.5 on the Claude subscription: quick edits and lookups. Uses Claude Code limits.",
      "model": "claude-agent/claude-haiku-5-5"
    },
    "compaction": { "model": "opencode-go/deepseek-v4.1-flash" },
    "title": { "model": "opencode-go/deepseek-v4.1-flash" },
    "summary": { "model": "opencode-go/deepseek-v4.1-flash" }
  },

  "compaction": { "buffer": "20%", "keep": { "tokens": 16000 } },

  // Global on purpose: workspace-aware, credential-free. A project entry replaces the whole
  // server object in OpenCode, so per-repo copies only drift.
  "mcp": {
    "servers": {
      "gopls": {
        "type": "local",
        "command": ["gopls", "mcp"],
        "codemode": false
      },
      "cclsp": {
        "type": "local",
        "command": ["npx", "-y", "cclsp@0.7.0"],
        "environment": { "CCLSP_CONFIG_PATH": "/Users/randell/.config/pi/cclsp.json" }
      }
    }
  }
}
